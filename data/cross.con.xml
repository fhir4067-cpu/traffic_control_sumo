<?xml version="1.0" encoding="iso-8859-1"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
   <!-- East approach: driver lane numbers 1..5 map to SUMO lanes 4..0. -->
   <connection from="2i" to="3o" fromLane="4" toLane="3" />
   <connection from="2i" to="3o" fromLane="3" toLane="2" />
   <connection from="2i" to="1o" fromLane="3" toLane="3" />
   <connection from="2i" to="1o" fromLane="2" toLane="2" />
   <connection from="2i" to="1o" fromLane="1" toLane="1" />
   <connection from="2i" to="4o" fromLane="0" toLane="0" />

   <!-- North approach: driver lane numbers 1..4 map to SUMO lanes 3..0. -->
   <connection from="4i" to="2o" fromLane="3" toLane="3" />
   <connection from="4i" to="3o" fromLane="2" toLane="2" />
   <connection from="4i" to="3o" fromLane="1" toLane="1" />
   <connection from="4i" to="1o" fromLane="0" toLane="0" />

   <!-- South approach: driver lane numbers 1..3 map to SUMO lanes 2..0. -->
   <connection from="3i" to="1o" fromLane="2" toLane="4" />
   <connection from="3i" to="4o" fromLane="2" toLane="2" />
   <connection from="3i" to="4o" fromLane="1" toLane="1" />
   <connection from="3i" to="2o" fromLane="0" toLane="0" />

   <!-- West approach: driver lane numbers 1..4 map to SUMO lanes 3..0. -->
   <connection from="1i" to="4o" fromLane="3" toLane="2" />
   <connection from="1i" to="2o" fromLane="2" toLane="2" />
   <connection from="1i" to="2o" fromLane="1" toLane="1" />
   <connection from="1i" to="3o" fromLane="0" toLane="0" />
</connections>
